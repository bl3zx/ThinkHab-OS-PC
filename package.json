{
  "name": "thinkhab",
  "productName": "ThinkHab",
  "version": "1.2.8",
  "description": "ThinkHab console launcher for Windows",
  "main": "main.js",
  "author": "ThinkHab",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.thinkhab.launcher",
    "productName": "ThinkHab",
    "copyright": "ThinkHab",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "ThinkHab-${version}.exe"
    }
  }
}
